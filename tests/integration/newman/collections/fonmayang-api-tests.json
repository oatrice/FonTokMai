		{
			"name": "1a. Public Runway Engine API - Happy Path (200 OK)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Returns valid runway metrics schema', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('days_remaining');",
							"    pm.expect(jsonData).to.have.property('total_balance_thb');",
							"    pm.expect(jsonData).to.have.property('budget_jars');",
							"    pm.expect(jsonData.budget_jars.length).to.eql(3);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{BASE_URL}}/api/runway",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"api",
						"runway"
					]
				}
			},
			"response": []
		},
