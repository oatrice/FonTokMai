		{
			"name": "3. Anonymous Auth Token Generation",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 or 201', function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"pm.test('Returns magic token', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('token');",
							"    pm.expect(jsonData.token).to.include('Fon-');",
							"    pm.environment.set('MAGIC_TOKEN', jsonData.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"transaction_id\": \"tx_newman_test_123\",\n  \"amount\": 500.0,\n  \"timestamp\": \"2026-07-23T12:00:00Z\"\n}"
				},
				"url": {
					"raw": "{{BASE_URL}}/auth/generate-token",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"auth",
						"generate-token"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Zero-PII Stripe Webhook Listener",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 or 400 (Signature Validated)', function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Stripe-Signature",
						"value": "t=1721660000,v1=test_sig"
					}
				],
				"body": {
