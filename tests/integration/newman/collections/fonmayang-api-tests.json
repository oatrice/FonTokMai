		{
			"name": "4c. Zero-PII Stripe Webhook - Happy Path (200 OK)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var CryptoJS = require('crypto-js');",
							"var secret = pm.environment.get('STRIPE_WEBHOOK_SECRET') || 'whsec_650bb99cccd0e13b302dd78e415ff759cda70f28a840607ca72351aeb8b76647';",
							"var timestamp = Math.floor(Date.now() / 1000).toString();",
							"var payload = '{\"id\":\"evt_test_valid_123\",\"object\":\"event\",\"type\":\"checkout.session.completed\",\"data\":{\"object\":{\"id\":\"cs_test_session_valid\",\"amount_total\":1000}}}';",
							"var signaturePayload = timestamp + '.' + payload;",
							"var hash = CryptoJS.HmacSHA256(signaturePayload, secret).toString(CryptoJS.enc.Hex);",
							"pm.environment.set('STRIPE_SIG', 't=' + timestamp + ',v1=' + hash);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Returns success status', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql('success');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Stripe-Signature",
						"value": "{{STRIPE_SIG}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\"id\":\"evt_test_valid_123\",\"object\":\"event\",\"type\":\"checkout.session.completed\",\"data\":{\"object\":{\"id\":\"cs_test_session_valid\",\"amount_total\":1000}}}"
				},
				"url": {
					"raw": "{{BASE_URL}}/api/webhooks/stripe",
					"host": [
