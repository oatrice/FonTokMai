{
	"info": {
		"_postman_id": "8f88921a-1234-4567-89ab-cdef01234567",
		"name": "FonMaYang API Integration Tests",
		"description": "Comprehensive integration test suite for FonMaYang APIs including Runway Engine, Budget Jars, Milestone Lock, Anonymous Auth, and Zero-PII Stripe Webhooks.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Public Runway Engine API",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Returns valid runway metrics', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('days_remaining');",
							"    pm.expect(jsonData).to.have.property('total_balance_thb');",
							"    pm.expect(jsonData).to.have.property('budget_jars');",
							"    pm.expect(jsonData.budget_jars.length).to.eql(3);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{BASE_URL}}/api/runway",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"api",
						"runway"
					]
				}
			},
			"response": []
		},
		{
