			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 400 Bad Request', function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"pm.test('Returns Invalid signature error message', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.detail).to.eql('Invalid signature');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
