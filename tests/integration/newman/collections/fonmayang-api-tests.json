			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Returns magic token with Fon- prefix', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('token');",
							"    pm.expect(jsonData.token).to.include('Fon-');",
							"    pm.environment.set('MAGIC_TOKEN', jsonData.token);",
