# ==============================================================================
# General Environment & Security
# ==============================================================================
ENVIRONMENT=development
CRON_SECRET=
WORKER_SECRET=
ADMIN_BYPASS_PASSWORD=
WORKER_BASE_URL=

DATABASE_URL=
HASH_SALT=

# ==============================================================================
# Google Cloud Platform (GCP) & Cloud Infrastructure
# ==============================================================================
GCP_PROJECT_ID=
GCP_LOCATION=asia-southeast1
CLOUD_TASKS_QUEUE=
STORAGE_BACKEND=local
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=

# GCP Cloud Billing Cost API (Issue #211)
GCP_BILLING_BIGQUERY_DATASET=

# GCP Budget Alert Auto-shutdown (Issue #72)
GCP_BILLING_ACCOUNT_ID=
BUDGET_AMOUNT_THB=10
CLOUD_RUN_SERVICE_NAME=fontokmai-api

# gRPC Fork Support to prevent deadlock
GRPC_ENABLE_FORK_SUPPORT=1

# ==============================================================================
# Weather & AI Data Provider APIs
# ==============================================================================
RAINBOW_API_KEY=
TOMORROW_API_KEY=
GEMINI_API_KEY=
OCR_SPACE_API_KEY=

# Xweather API (Disabled by default)
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
XWEATHER_ENABLED=false

# Weather Alert Thresholds
ALERT_COOLDOWN_MINUTES=30
RAIN_TRIGGER_THRESHOLD_MM=5.0

# ==============================================================================
# Messaging Platforms (Telegram & LINE OA)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
DEV_TELEGRAM_BOT_TOKEN=
DEVELOPER_CHAT_IDS=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ==============================================================================
# Stripe Payments & Payout Webhook (Issue #210)
# ==============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# Local Testing & Mock Overrides
# ==============================================================================
USE_SKN240_BACKUP=false
USE_LOCAL_FIXTURES=false
FORCE_GCP_REAL_DATA=false

DATABASE_URL=
HASH_SALT=
