# Cloud Run deployment settings for FonMaYang.
# Keep non-secret deployment configuration here so CI and manual deploys
# use the same locked values.

# Service identity
CLOUD_RUN_SERVICE=fontokmai-api
CLOUD_RUN_REGION=asia-southeast1
CLOUD_RUN_SERVICE_ACCOUNT=cloud-run-runtime@fonmayang.iam.gserviceaccount.com

# Access model
CLOUD_RUN_ALLOW_UNAUTHENTICATED=true

# Runtime sizing
CLOUD_RUN_MEMORY=1Gi
CLOUD_RUN_CPU=1
CLOUD_RUN_TIMEOUT=300
CLOUD_RUN_CONCURRENCY=40

# Scale profile
# min=0 allows scaling to zero to save costs when there are no requests.
# max=2 limits burst cost while still allowing a small amount of parallelism.
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_MAX_INSTANCES=2

# CPU behavior
# 2026-06-23: กลับมาใช้ CPU Throttling ตามปกติเพื่อป้องกันบิลบานปลายจาก Worker
CLOUD_RUN_CPU_BOOST=true
CLOUD_RUN_NO_CPU_THROTTLING=false
